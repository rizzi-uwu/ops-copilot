# Copy this file to .env and fill in ONE of the two keys (`make setup` does the copy).
# .env is git-ignored. Never commit real keys.

# --- Model provider ---
# DeepSeek (used if set): platform.deepseek.com
DEEPSEEK_API_KEY=
# Anthropic (used if no DeepSeek key is set): console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: force a provider (deepseek or anthropic) when both keys are set
OPS_COPILOT_PROVIDER=
# Optional: override the model (default: deepseek-flash or claude-sonnet-5-5)
OPS_COPILOT_MODEL=

# --- Defaults for `make run` ---
TRANSCRIPT=data/transcripts/meeting_05_month_end_finance.txt
# Language of the drafted letters: en or de
LETTER_LANG=en

# --- Optional: Notion board (needed only for `make push`) ---
NOTION_TOKEN=
NOTION_DATABASE_ID=6084e5fea946457bb2018724cf52fc1b
